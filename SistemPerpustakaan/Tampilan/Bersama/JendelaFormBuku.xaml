<Window x:Class="SistemPerpustakaan.Tampilan.Bersama.JendelaFormBuku"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Buku" Height="680" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28">
            <TextBlock x:Name="JudulForm" Text="Tambah Buku Baru"
                       FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,24"/>

            <!-- Cover preview + tombol pilih -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="120" Height="160" CornerRadius="8"
                        ClipToBounds="True" Background="#F1F5F9">
                    <Image x:Name="PreviewSampul" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Sampul Buku" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,8"/>
                    <TextBlock Text="JPG, PNG, atau BMP — maks 5 MB"
                               FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>
                    <Button Content="📁  Pilih Gambar" Style="{StaticResource TombolSekunder}"
                            Padding="16,8" Click="TombolPilihGambar_Click"/>
                    <TextBlock x:Name="NamaFileSampul" Text="Belum dipilih"
                               FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Form field 2 kolom -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Judul Buku *" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakJudul" Style="{StaticResource KotakTeks}" Height="44"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Penulis *" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakPenulis" Style="{StaticResource KotakTeks}" Height="44"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Penerbit" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakPenerbit" Style="{StaticResource KotakTeks}" Height="44"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kategori" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <ComboBox x:Name="KotakKategori" Height="44" FontSize="14"
                              IsEditable="True"
                              Padding="12,0">
                        <ComboBoxItem Content="Fiksi"/>
                        <ComboBoxItem Content="Non-Fiksi"/>
                        <ComboBoxItem Content="Sejarah"/>
                        <ComboBoxItem Content="Teknologi"/>
                        <ComboBoxItem Content="Pengembangan Diri"/>
                        <ComboBoxItem Content="Sains"/>
                        <ComboBoxItem Content="Biografi"/>
                        <ComboBoxItem Content="Pendidikan"/>
                        <ComboBoxItem Content="Agama"/>
                        <ComboBoxItem Content="Lainnya"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/><ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ISBN" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakIsbn" Style="{StaticResource KotakTeks}" Height="44"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tahun Terbit" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakTahun" Style="{StaticResource KotakTeks}" Height="44"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Jumlah Stok *" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakStok" Style="{StaticResource KotakTeks}"
                             Height="44" Text="1"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Deskripsi / Sinopsis" FontSize="13" FontWeight="SemiBold"
                       Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox x:Name="KotakDeskripsi" Style="{StaticResource KotakTeks}"
                     Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

            <!-- Harga Buku -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Harga Buku (Rp)" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakHarga" Style="{StaticResource KotakTeks}"
                             Height="44" Text="0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#FFF7ED" CornerRadius="8"
                        Padding="12,10" VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Digunakan sebagai acuan denda jika buku hilang."
                                   FontSize="12" Foreground="#92400E"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pesan Error -->
            <Border x:Name="PanelError" Visibility="Collapsed"
                    Background="#FEF2F2" BorderBrush="#FECACA"
                    BorderThickness="1" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,16">
                <TextBlock x:Name="TeksError" Foreground="#DC2626" FontSize="13"/>
            </Border>

            <!-- Tombol aksi -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Style="{StaticResource TombolSekunder}"
                        Padding="20,10" Margin="0,0,12,0"
                        Click="TombolBatal_Click"/>
                <Button x:Name="TombolSimpan" Content="Simpan Buku"
                        Style="{StaticResource TombolSukses}"
                        Padding="20,10" Click="TombolSimpan_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
