<Window x:Class="SistemPerpustakaan.Tampilan.Bersama.JendelaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masuk — Sistem Perpustakaan"
        Height="600" Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel kiri: ilustrasi -->
        <Border Grid.Column="0" Background="#2563EB">
            <Grid>
                <Ellipse Width="280" Height="280" Fill="#1D4ED8" Opacity="0.5"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-80,-80,0,0"/>
                <Ellipse Width="180" Height="180" Fill="#1D4ED8" Opacity="0.4"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-50,-50"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36">
                    <TextBlock Text="📚" FontSize="56"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Perpustakaan Digital"
                               FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Kelola koleksi buku dengan&#10;mudah dan efisien"
                               FontSize="13" Foreground="#BFDBFE"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,10,0,32" LineHeight="22"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse Width="7" Height="7" Fill="#60A5FA" Margin="0,0,10,0"/>
                            <TextBlock Text="Manajemen buku &amp; koleksi"
                                       Foreground="#BFDBFE" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse Width="7" Height="7" Fill="#60A5FA" Margin="0,0,10,0"/>
                            <TextBlock Text="Peminjaman &amp; pengembalian"
                                       Foreground="#BFDBFE" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse Width="7" Height="7" Fill="#60A5FA" Margin="0,0,10,0"/>
                            <TextBlock Text="Laporan &amp; manajemen denda"
                                       Foreground="#BFDBFE" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel kanan: form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="48,36">

                <!-- Judul -->
                <TextBlock x:Name="JudulForm" Text="Selamat Datang Kembali"
                           FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock x:Name="SubjudulForm" Text="Masuk ke akun Anda"
                           FontSize="13" Foreground="#64748B" Margin="0,6,0,24"/>

                <!-- Panel Error -->
                <Border x:Name="PanelError" Visibility="Collapsed"
                        Background="#FEF2F2" BorderBrush="#FECACA"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ " Foreground="#DC2626" FontSize="14"/>
                        <TextBlock x:Name="TeksError" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Panel Sukses -->
                <Border x:Name="PanelSukses" Visibility="Collapsed"
                        Background="#F0FDF4" BorderBrush="#BBF7D0"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓ " Foreground="#16A34A" FontSize="14"/>
                        <TextBlock x:Name="TeksSukses" Foreground="#16A34A"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ══ PANEL LOGIN ══════════════════════════════════════ -->
                <StackPanel x:Name="PanelLogin">
                    <TextBlock Text="Nama Pengguna" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakNamaPengguna" Style="{StaticResource KotakTeks}"
                             Height="46" Margin="0,0,0,16"
                             KeyDown="KotakTeks_KeyDown"/>

                    <TextBlock Text="Kata Sandi" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="KotakKataSandi" Style="{StaticResource KotakSandi}"
                                 Height="46" Margin="0,0,0,24"
                                 KeyDown="KotakKataSandi_KeyDown"/>

                    <Button x:Name="TombolMasuk" Content="Masuk"
                            Style="{StaticResource TombolUtama}"
                            Height="48" FontSize="15"
                            Click="TombolMasuk_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Belum punya akun? " FontSize="13" Foreground="#64748B"/>
                        <Button Content="Daftar sekarang"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"
                                Cursor="Hand" Padding="0"
                                Click="TombolKeRegistrasi_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ══ PANEL REGISTRASI ═════════════════════════════════ -->
                <StackPanel x:Name="PanelRegistrasi" Visibility="Collapsed">
                    <TextBlock Text="Nama Lengkap" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakNamaLengkap" Style="{StaticResource KotakTeks}"
                             Height="46" Margin="0,0,0,14"/>

                    <TextBlock Text="Nama Pengguna" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakNamaPenggunaReg" Style="{StaticResource KotakTeks}"
                             Height="46" Margin="0,0,0,14"/>

                    <TextBlock Text="Surel (Email)" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakSurel" Style="{StaticResource KotakTeks}"
                             Height="46" Margin="0,0,0,14"/>

                    <TextBlock Text="Nomor Telepon (Opsional)" FontSize="13"
                               FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="KotakTelepon" Style="{StaticResource KotakTeks}"
                             Height="46" Margin="0,0,0,14"/>

                    <TextBlock Text="Kata Sandi" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="KotakKataSandiReg" Style="{StaticResource KotakSandi}"
                                 Height="46" Margin="0,0,0,14"/>

                    <TextBlock Text="Konfirmasi Kata Sandi" FontSize="13"
                               FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="KotakKonfirmasi" Style="{StaticResource KotakSandi}"
                                 Height="46" Margin="0,0,0,24"/>

                    <Button x:Name="TombolDaftar" Content="Buat Akun"
                            Style="{StaticResource TombolUtama}"
                            Height="48" FontSize="15"
                            Click="TombolDaftar_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock Text="Sudah punya akun? " FontSize="13" Foreground="#64748B"/>
                        <Button Content="Masuk di sini"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"
                                Cursor="Hand" Padding="0"
                                Click="TombolKeLogin_Click"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
