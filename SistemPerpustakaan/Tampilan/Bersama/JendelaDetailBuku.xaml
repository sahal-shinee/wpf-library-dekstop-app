<Window x:Class="SistemPerpustakaan.Tampilan.Bersama.JendelaDetailBuku"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detail Buku" Height="560" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Cover buku -->
        <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True"
                Background="#F1F5F9" Width="180" Height="260"
                VerticalAlignment="Top">
            <Image x:Name="GambarSampul" Stretch="UniformToFill"/>
        </Border>

        <!-- Info buku -->
        <StackPanel Grid.Column="1" Margin="24,0,0,0">
            <TextBlock x:Name="TeksJudul" FontSize="22" FontWeight="Bold"
                       Foreground="#1E293B" TextWrapping="Wrap"/>
            <TextBlock x:Name="TeksPenulis" FontSize="14" Foreground="#64748B"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="TeksKategori" FontSize="13" Foreground="#0891B2"
                       Margin="0,4,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Penerbit" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TeksPenerbit" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Tahun" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TeksTahun" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ISBN" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TeksIsbn" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- Status stok -->
            <Border x:Name="PanelTersedia" Margin="0,16,0,0" Padding="12,8"
                    CornerRadius="8" Background="#F0FDF4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="#16A34A" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TeksKetersediaan" FontSize="13"
                               Foreground="#16A34A" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Deskripsi -->
            <TextBlock Text="Deskripsi" FontSize="12" FontWeight="Bold"
                       Foreground="#64748B" Margin="0,20,0,6"/>
            <TextBlock x:Name="TeksDeskripsi" FontSize="13" Foreground="#475569"
                       TextWrapping="Wrap" LineHeight="20"/>

            <!-- Tombol aksi -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="TombolPinjam" Content="Tambah ke Keranjang"
                        Style="{StaticResource TombolUtama}"
                        Padding="20,10" Click="TombolPinjam_Click"/>
                <Button Content="Tutup" Style="{StaticResource TombolSekunder}"
                        Padding="20,10" Margin="12,0,0,0"
                        Click="TombolTutup_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
