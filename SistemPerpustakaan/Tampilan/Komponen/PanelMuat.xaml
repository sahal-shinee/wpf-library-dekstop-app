<UserControl x:Class="SistemPerpustakaan.Tampilan.Komponen.PanelMuat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="#80FFFFFF">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Lingkaran animasi -->
            <Border Width="48" Height="48" CornerRadius="24"
                    BorderBrush="#2563EB" BorderThickness="4"
                    HorizontalAlignment="Center">
                <Border.RenderTransform>
                    <RotateTransform x:Name="PutarTransform" CenterX="24" CenterY="24"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetName="PutarTransform"
                                    Storyboard.TargetProperty="Angle"
                                    From="0" To="360" Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <TextBlock x:Name="TeksMuat" Text="Memuat..."
                       FontSize="13" Foreground="#64748B"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
