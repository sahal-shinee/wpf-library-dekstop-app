<UserControl x:Class="SistemPerpustakaan.Tampilan.Komponen.KartuBuku"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="196" Cursor="Hand">
    <Border x:Name="KartuBorder" Background="White" CornerRadius="14"
            BorderBrush="#E5E7EB" BorderThickness="1.5"
            MouseEnter="Kartu_MouseEnter" MouseLeave="Kartu_MouseLeave"
            MouseLeftButtonUp="Kartu_Klik">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                              Opacity="0.07" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Area gambar sampul -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                <Grid>
                    <!-- Background gradient sebagai placeholder (selalu tampil) -->
                    <Border x:Name="BgPlaceholder" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="GradWarna1" Color="#3B82F6" Offset="0"/>
                                <GradientStop x:Name="GradWarna2" Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Dekorasi background -->
                        <Grid>
                            <Ellipse Width="120" Height="120" Opacity="0.15"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-30,-30,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="80" Height="80" Opacity="0.1"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                     Margin="-20,0,0,-20">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Ikon buku besar di tengah -->
                            <TextBlock x:Name="IkonPlaceholder" Text="📖"
                                       FontSize="52"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Gambar sampul aktual (di atas background) -->
                    <Image x:Name="GambarSampul" Stretch="UniformToFill"
                           VerticalAlignment="Center"/>

                    <!-- Badge ketersediaan -->
                    <Border x:Name="BadgeStatus" CornerRadius="20"
                            Padding="10,5" Margin="8,8,0,0"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Background="#16A34A">
                        <TextBlock x:Name="TeksBadge" FontSize="11"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Badge keranjang (terpilih) -->
                    <Border x:Name="BadgeKeranjang" Visibility="Collapsed"
                            Width="30" Height="30" CornerRadius="15"
                            Background="#1D4ED8"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Margin="0,8,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                              Opacity="0.3" Color="#1D4ED8"/>
                        </Border.Effect>
                        <TextBlock Text="✓" FontSize="15" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Info buku -->
            <StackPanel Grid.Row="1" Margin="14,10,14,14">
                <TextBlock x:Name="TeksJudul" FontSize="13" FontWeight="SemiBold"
                           Foreground="#111827" TextWrapping="Wrap"
                           MaxHeight="42" TextTrimming="CharacterEllipsis"
                           LineHeight="20"/>
                <TextBlock x:Name="TeksPenulis" FontSize="11" Foreground="#6B7280"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="PilBadgeKategori" CornerRadius="6"
                        Padding="7,3" Margin="0,7,0,0"
                        HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EFF6FF"/>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="TeksKategori" FontSize="10"
                               Foreground="#1D4ED8" FontWeight="Medium"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
