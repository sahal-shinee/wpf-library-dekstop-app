<Page x:Class="SistemPerpustakaan.Tampilan.Admin.HalamanLaporan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Gaya Tombol Sekunder (Untuk Pratinjau & Reset) -->
        <Style x:Key="TombolSekunder" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gaya Efek Bayangan untuk Kartu -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.06" Direction="270" Color="#0F172A"/>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Kontrol Filter Panel -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,15" Margin="0,0,0,25" Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Judul Halaman -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pusat Laporan &amp; Ekspor" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Kelola dan unduh data perpustakaan ke dalam format PDF." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filter Tanggal -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="15,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,4h-1V2h-2v2H8V2H6v2H5C3.89,4,3,4.9,3,6v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V6C21,4.9,20.1,4,19,4z M19,20H5V10h14V20z" 
                                  Fill="#94A3B8" Width="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Periode:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569" FontWeight="SemiBold"/>

                            <DatePicker x:Name="TanggalMulai" Width="120" SelectedDateFormat="Short" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>

                            <TextBlock Text="-" VerticalAlignment="Center" Margin="10,0" Foreground="#94A3B8" FontWeight="Bold"/>

                            <DatePicker x:Name="TanggalSampai" Width="120" SelectedDateFormat="Short" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Reset Filter" Margin="12,0,0,0" Style="{StaticResource TombolSekunder}" Click="ResetTanggal_Click" ToolTip="Bersihkan filter tanggal"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid 3 Kartu Laporan -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- KARTU 1: PEMINJAMAN -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,10,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <!-- Ikon melingkar -->
                    <Border Background="#EFF6FF" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Laporan Peminjaman" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Unduh seluruh rekam jejak aktivitas peminjaman dan pengembalian ke dalam format dokumen PDF (Landscape)."
                               FontSize="13" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="20"/>

                    <!-- Tombol Aksi -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Pratinjau" Style="{StaticResource TombolSekunder}" Margin="0,0,5,0" Click="PratinjauPeminjaman_Click"/>
                        <Button Grid.Column="1" Content="Ekspor PDF" Style="{StaticResource TombolUtama}" Margin="5,0,0,0" Click="EksporPeminjamanPdf_Click" ToolTip="Ekspor ke PDF"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- KARTU 2: DENDA -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" Margin="10,0,10,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <!-- Ikon melingkar -->
                    <Border Background="#FEF2F2" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Laporan Denda" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Rekapitulasi total denda keterlambatan anggota perpustakaan beserta status pembayarannya dalam bentuk PDF."
                               FontSize="13" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="20"/>

                    <!-- Tombol Aksi -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Pratinjau" Style="{StaticResource TombolSekunder}" Margin="0,0,5,0" Click="PratinjauDenda_Click"/>
                        <Button Grid.Column="1" Content="Ekspor PDF" Style="{StaticResource TombolUtama}" Margin="5,0,0,0" Click="EksporDendaPdf_Click" ToolTip="Ekspor ke PDF"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- KARTU 3: KOLEKSI BUKU -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="25" Margin="10,0,0,0" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <!-- Ikon melingkar -->
                    <Border Background="#F0FDF4" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Laporan Koleksi Buku" FontSize="16" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Cetak inventaris seluruh katalog buku yang tersedia di perpustakaan beserta informasi detail stok saat ini."
                               FontSize="13" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="20"/>

                    <!-- Tombol Aksi -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Pratinjau" Style="{StaticResource TombolSekunder}" Margin="0,0,5,0" Click="PratinjauBuku_Click"/>
                        <Button Grid.Column="1" Content="Ekspor PDF" Style="{StaticResource TombolUtama}" Margin="5,0,0,0" Click="EksporBukuPdf_Click" ToolTip="Ekspor ke PDF"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Teks Status Notifikasi -->
        <Border Grid.Row="3" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" 
                HorizontalAlignment="Center" Margin="0,25,0,0" Padding="15,10" x:Name="PanelStatus" Visibility="Hidden">
            <Border.Style>
                <!-- Menyembunyikan border jika teks kosong -->
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=TeksStatus}" Value="">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Path Data="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" Fill="#15803D" Width="16" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock x:Name="TeksStatus" Text="" FontSize="14" FontWeight="Medium" Foreground="#15803D" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>