<Page x:Class="SistemPerpustakaan.Tampilan.Admin.HalamanPeminjamanAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid x:Name="RootGrid" Margin="24">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideRoot"/></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12"
                Padding="16,12" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Kotak cari -->
                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1.5"
                        CornerRadius="8" Background="White">
                    <Grid>
                        <TextBlock Text="🔍" FontSize="14" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9CA3AF"/>
                        <TextBlock Text="Cari nama peminjam..."
                                   FontSize="13" Foreground="#CBD5E1"
                                   Margin="36,0,12,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=KotakCari}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="KotakCari"
                                 Padding="36,10,12,10" FontSize="13"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#111827"
                                 TextChanged="KotakCari_Changed"/>
                    </Grid>
                </Border>

                <!-- Filter status -->
                <ComboBox Grid.Column="2" x:Name="FilterStatus"
                          Height="42" FontSize="13" Padding="12,0"
                          BorderBrush="#E5E7EB" BorderThickness="0"
                          SelectionChanged="FilterStatus_Changed"
                          Background="Transparent">
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border"
                                        Background="White"
                                        CornerRadius="10"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Padding="10,6"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          VerticalAlignment="Center"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          Margin="4,0,0,0"
                                                          RecognizesAccessKey="True"/>

                                        <ToggleButton Grid.Column="1" x:Name="ToggleButton"
                                                      Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Width="28" Height="28"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Path Data="M 0 0 L 8 0 L 4 6 Z"
                                                  Fill="#6B7280" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6" Margin="0,6,0,0">
                                        <ScrollViewer MaxHeight="220">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ComboBox.Template>

                    <!-- item style for nicer hover and selection -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>

                    <ComboBoxItem Content="Semua Status" IsSelected="True"/>
                    <ComboBoxItem Content="aktif"/>
                    <ComboBoxItem Content="sebagian_kembali"/>
                    <ComboBoxItem Content="terlambat"/>
                    <ComboBoxItem Content="selesai"/>
                </ComboBox>

                <!-- Tombol muat ulang dengan label jelas -->
                <Button Grid.Column="4" Height="42" Padding="16,0"
                        Click="MuatUlang_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#F3F4F6" BorderBrush="#E5E7EB"
                                    BorderThickness="1.5" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="16" Foreground="#374151"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Muat Ulang" FontSize="13"
                                               Foreground="#374151" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Info jumlah -->
        <TextBlock Grid.Row="1" x:Name="TeksInfo" Text="Memuat..."
                   FontSize="13" Foreground="#6B7280" Margin="4,0,0,12"/>

        <!-- Tabel peminjaman -->
        <Border Grid.Row="2" Background="White" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header tabel -->
                <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="14,14,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID"            FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="1" Text="Nama Peminjam" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="16,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Tgl Pinjam"   FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="3" Text="Batas Kembali" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="4" Text="Hari Terlambat" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="5" Text="Status"       FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="6" Text="Catatan"      FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                    </Grid>
                </Border>

                <!-- DataGrid tanpa header bawaan -->
                <Grid Grid.Row="1">
                <DataGrid x:Name="TabelPeminjaman"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" GridLinesVisibility="None"
                          HeadersVisibility="None"
                          Background="White" BorderThickness="0"
                          RowHeight="56" SelectionMode="Single"
                          AlternatingRowBackground="#FAFAFA"
                          SelectionChanged="TabelPeminjaman_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F7FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding IdPeminjaman}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Nama Peminjam -->
                        <DataGridTextColumn Binding="{Binding NamaPeminjam}" Width="*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TanggalPinjam, StringFormat=dd/MM/yyyy}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding BatasKembali, StringFormat=dd/MM/yyyy}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding HariTerlambat}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Badge Status -->
                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="20" Padding="10,5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="terlambat">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="sebagian_kembali">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="selesai">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TampilStatus}" FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="terlambat">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="sebagian_kembali">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="selesai">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding Catatan}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tambahkan kolom aksi: Hapus -->
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Tag="{Binding IdPeminjaman}"
                                                Click="TombolHapusPeminjaman_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="#FEF2F2" CornerRadius="8" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🗑" FontSize="12" Foreground="#DC2626" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Hapus" FontSize="12" Foreground="#DC2626" FontWeight="Medium"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Template detail buku saat baris dipilih -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFF" Padding="76,12,16,16"
                                    BorderBrush="#E0E7FF" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="Daftar Buku yang Dipinjam:"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#4B5563" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding DetailBuku}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="8"
                                                        BorderBrush="#E5E7EB" BorderThickness="1"
                                                        Padding="14,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="160"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="📗" FontSize="14" Margin="0,0,8,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding JudulBuku}"
                                                                       FontSize="13" FontWeight="Medium"
                                                                       Foreground="#111827"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding PenulisBuku}"
                                                                   FontSize="12" Foreground="#6B7280"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" CornerRadius="6" Padding="8,3"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SudahKembali}" Value="True">
                                                                            <Setter Property="Background" Value="#F0FDF4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TampilStatusBuku}"
                                                                       FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SudahKembali}" Value="True">
                                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <!-- Empty state -->
                <Border x:Name="PanelKosong" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="48,40">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📤" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tidak ada data peminjaman"
                                   FontSize="15" FontWeight="Medium" Foreground="#374151"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Coba ubah filter status atau kata kunci pencarian"
                                   FontSize="12" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Paging controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Click="TombolPrev_Click" Style="{StaticResource TombolSekunder}" Padding="10,6" Margin="0,0,8,0">Prev</Button>
            <TextBlock x:Name="TeksHalaman" VerticalAlignment="Center" Foreground="#6B7280" Margin="6,0">Halaman</TextBlock>
            <Button Click="TombolNext_Click" Style="{StaticResource TombolSekunder}" Padding="10,6" Margin="8,0,0,0">Next</Button>
        </StackPanel>
    </Grid>
</Page>