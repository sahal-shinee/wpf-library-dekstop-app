<Page x:Class="SistemPerpustakaan.Tampilan.Admin.HalamanDasbordAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScroll"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.RenderTransform>
            <TranslateTransform x:Name="SlideRoot"/>
        </ScrollViewer.RenderTransform>
        <StackPanel Margin="28,24,28,28">

            <!-- ══ KARTU STATISTIK ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Total Buku -->
                <Border Grid.Column="0" Background="White" CornerRadius="14"
                        Margin="0,0,14,0" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#EFF6FF">
                                <TextBlock Text="📖" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Buku" FontSize="13" Foreground="#6B7280"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="TotalBuku" Text="0"
                                   FontSize="36" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Grid.Row="2" x:Name="BukuTersedia" Text="0 tersedia"
                                   FontSize="12" Foreground="#16A34A" Margin="0,4,0,0" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- Dipinjam -->
                <Border Grid.Column="1" Background="White" CornerRadius="14"
                        Margin="0,0,14,0" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED">
                                <TextBlock Text="📤" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sedang Dipinjam" FontSize="13" Foreground="#6B7280"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="TotalDipinjam" Text="0"
                                   FontSize="36" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Grid.Row="2" x:Name="DipinjamTerlambat" Text="0 terlambat"
                                   FontSize="12" Foreground="#DC2626" Margin="0,4,0,0" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- Anggota -->
                <Border Grid.Column="2" Background="White" CornerRadius="14"
                        Margin="0,0,14,0" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#F0FDF4">
                                <TextBlock Text="👥" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Anggota" FontSize="13" Foreground="#6B7280"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="TotalAnggota" Text="0"
                                   FontSize="36" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Grid.Row="2" x:Name="AnggotaAktif" Text="0 aktif"
                                   FontSize="12" Foreground="#16A34A" Margin="0,4,0,0" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <!-- Denda -->
                <Border Grid.Column="3" Background="White" CornerRadius="14" Padding="22,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FEF2F2">
                                <TextBlock Text="💰" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Denda Belum Lunas" FontSize="13" Foreground="#6B7280"
                                       Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="TotalDendaBelumLunas" Text="Rp 0"
                                   FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Grid.Row="2" x:Name="JumlahTagihanDenda" Text="0 tagihan"
                                   FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ PEMINJAMAN TERLAMBAT ═══════════════════════════════ -->
            <Border Background="White" CornerRadius="14" Margin="0,0,0,20" Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Peminjaman Terlambat" FontSize="16"
                                   FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeTerlambat" Background="#FEE2E2"
                                CornerRadius="20" Padding="10,4" Margin="12,0,0,0">
                            <TextBlock x:Name="TeksBadgeTerlambat" Text="0"
                                       FontSize="12" Foreground="#DC2626" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Header tabel custom -->
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="16,10" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nama Peminjam" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="Tgl Pinjam" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="2" Text="Batas Kembali" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="3" Text="Hari Terlambat" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="4" Text="Jml Buku" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="5" Text="Status" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="TabelTerlambat" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" GridLinesVisibility="None"
                              HeadersVisibility="None"
                              Background="White" BorderThickness="0"
                              SelectionMode="Single" RowHeight="52"
                              AlternatingRowBackground="#FAFAFA"
                              MaxHeight="260">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding NamaPeminjam}" Width="*" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="16,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TanggalPinjam, StringFormat=dd/MM/yyyy}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding BatasKembali, StringFormat=dd/MM/yyyy}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding HariTerlambat}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding DetailBuku.Count}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Background="#FEE2E2"
                                                Padding="10,4" HorizontalAlignment="Left"
                                                Margin="0,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TampilStatus}"
                                                       FontSize="12" FontWeight="Medium"
                                                       Foreground="#DC2626"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="PanelKosongTerlambat" Visibility="Collapsed"
                            Background="#F0FDF4" CornerRadius="10"
                            Padding="24" Margin="0,8,0,4">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="28"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Tidak ada peminjaman terlambat saat ini"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="#16A34A"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ KOLEKSI BUKU TERBARU ═══════════════════════════════ -->
            <Border Background="White" CornerRadius="14" Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Koleksi Buku Terbaru" FontSize="16"
                               FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

                    <Border Background="#F9FAFB" CornerRadius="8" Padding="16,10" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Judul" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="Penulis" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="2" Text="Kategori" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="3" Text="Ketersediaan" FontSize="12"
                                       FontWeight="Bold" Foreground="#6B7280"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="TabelBukuTerbaru" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" GridLinesVisibility="None"
                              HeadersVisibility="None"
                              Background="White" BorderThickness="0"
                              RowHeight="52" MaxHeight="240"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Judul}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="16,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Penulis}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="#EFF6FF"
                                                Padding="8,3" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Kategori}"
                                                       FontSize="12" Foreground="#1D4ED8"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tersedia}" Value="False">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TampilKetersediaan}" FontSize="12" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tersedia}" Value="False">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>