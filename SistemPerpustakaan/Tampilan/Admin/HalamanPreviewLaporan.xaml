<Window x:Class="SistemPerpustakaan.Tampilan.Admin.HalamanPreviewLaporan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pratinjau Laporan" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

	<Window.Resources>
		<!-- Gaya Tombol Modern Utama -->
		<Style x:Key="ModernButton" TargetType="Button">
			<Setter Property="Background" Value="#2980b9"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="15,8"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#3498db"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#1f618d"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Background" Value="#bdc3c7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Gaya DataGrid Kelas Enterprise -->
		<Style TargetType="DataGrid">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E0E6ED"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="RowBackground" Value="White"/>
			<Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
			<Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7"/>
			<Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
			<Setter Property="AutoGenerateColumns" Value="True"/>
			<Setter Property="CanUserAddRows" Value="False"/>
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="HeadersVisibility" Value="Column"/>
			<Setter Property="SelectionMode" Value="Single"/>
			<Setter Property="RowHeight" Value="40"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="GridLinesVisibility" Value="Horizontal"/>
		</Style>

		<Style TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#F1F5F9"/>
			<Setter Property="Foreground" Value="#475569"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="15,10"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
		</Style>

		<Style TargetType="DataGridCell">
			<Setter Property="Padding" Value="15,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="DataGridCell">
						<Border Padding="{TemplateBinding Padding}" Background="Transparent">
							<ContentPresenter VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="#E0F2FE"/>
					<Setter Property="Foreground" Value="#0369A1"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="10" Margin="15">
		<Border.Effect>
			<DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.15" Direction="270"/>
		</Border.Effect>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Title Bar -->
				<RowDefinition Height="Auto"/>
				<!-- Toolbar -->
				<RowDefinition Height="*"/>
				<!-- DataGrid -->
				<RowDefinition Height="Auto"/>
				<!-- Footer -->
			</Grid.RowDefinitions>

			<!-- Custom Title Bar -->
			<Border Grid.Row="0" Background="#1E293B" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Orientation="Vertical" Margin="25,20">
						<TextBlock x:Name="TxtJudul" Foreground="White" FontSize="22" FontWeight="Bold"/>
						<TextBlock x:Name="TxtSubJudul" Foreground="#94A3B8" FontSize="13" Margin="0,5,0,0"/>
					</StackPanel>

					<Button Grid.Column="1" Click="BtnClose_Click" Width="45" Height="45" Margin="15"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Tutup Pratinjau">
						<Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="#CBD5E1" Stretch="Uniform" Width="18"/>
					</Button>
				</Grid>
			</Border>

			<!-- Toolbar (Pencarian & Kontrol) -->
			<Grid Grid.Row="1" Margin="25,20,25,15">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Search Box -->
				<Border Grid.Column="0" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Width="300" Background="White">
					<Grid>
						<Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="#94A3B8" Width="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0"/>
						<TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent" Padding="40,10,10,10"
                                 VerticalContentAlignment="Center" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
						<TextBlock IsHitTestVisible="False" Text="Cari data apa saja..." Foreground="#94A3B8" FontSize="13"
                                   VerticalAlignment="Center" Margin="40,0,0,0">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Hidden"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding Text.Length, ElementName=TxtSearch}" Value="0">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
				</Border>

				<!-- ComboBox Per Halaman -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
					<TextBlock Text="Tampil:" VerticalAlignment="Center" Foreground="#64748B" FontSize="13" Margin="0,0,8,0"/>
					<ComboBox x:Name="CboPerHalaman" Width="70" Height="35" VerticalContentAlignment="Center" SelectionChanged="CboPerHalaman_SelectionChanged">
						<ComboBoxItem Content="15" IsSelected="True"/>
						<ComboBoxItem Content="50"/>
						<ComboBoxItem Content="100"/>
						<ComboBoxItem Content="Semua"/>
					</ComboBox>
				</StackPanel>

				<!-- Export Button -->
				<Button Grid.Column="3" Style="{StaticResource ModernButton}" Click="BtnExport_Click" ToolTip="Ekspor data yang tampil di layar ke PDF">
					<StackPanel Orientation="Horizontal">
						<Path Data="M19,9h-4V3H9v6H5l7,7L19,9z M5,18v2h14v-2H5z" Fill="White" Width="16" Stretch="Uniform" Margin="0,0,8,0"/>
						<TextBlock Text="Ekspor PDF Halaman Ini" VerticalAlignment="Center" FontSize="13"/>
					</StackPanel>
				</Button>
			</Grid>

			<!-- DataGrid Utama -->
			<DataGrid x:Name="GridData" Grid.Row="2" Margin="25,0" AutoGeneratingColumn="GridData_AutoGeneratingColumn"/>

			<!-- Footer Paginasi -->
			<Border Grid.Row="3" Background="#F8FAFC" CornerRadius="0,0,10,10" Margin="0,15,0,0" Padding="25,15">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock x:Name="TxtInfoBaris" Grid.Column="0" Foreground="#64748B" VerticalAlignment="Center" FontSize="13"/>

					<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="BtnPrev" Content="&#x276E; Seb" Width="75" Margin="0,0,15,0" Style="{StaticResource ModernButton}"
                                Background="White" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnPrev_Click"/>

						<TextBlock x:Name="TxtPaginasi" Text="Hal 1 / 1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" FontSize="14" Margin="0,0,15,0"/>

						<Button x:Name="BtnNext" Content="Lanjut &#x276F;" Width="75" Style="{StaticResource ModernButton}"
                                Background="White" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnNext_Click"/>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>