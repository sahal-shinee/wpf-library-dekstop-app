<Page x:Class="SistemPerpustakaan.Tampilan.Admin.HalamanKelolaBuku"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="RootGrid" Margin="24">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideRoot"/></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12"
                Padding="16,12" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Kotak cari dengan placeholder -->
                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1.5"
                        CornerRadius="8" Background="White">
                    <Grid>
                        <TextBlock Text="🔍" FontSize="14" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9CA3AF"/>
                        <TextBlock Text="Cari judul, penulis, atau ISBN..."
                                   FontSize="13" Foreground="#CBD5E1"
                                   Margin="36,0,12,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=KotakCari}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="KotakCari" Padding="36,10,12,10"
                                 FontSize="13" BorderThickness="0" Background="Transparent"
                                 Foreground="#111827" TextChanged="KotakCari_TextChanged"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="2" x:Name="FilterKategori"
                          Height="42" FontSize="13" Padding="12,0"
                          BorderBrush="#E5E7EB" BorderThickness="0"
                          SelectionChanged="FilterKategori_Changed"
                          Background="Transparent">
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border"
                                        Background="White"
                                        CornerRadius="10"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Padding="10,6"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          VerticalAlignment="Center"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          Margin="4,0,0,0"
                                                          RecognizesAccessKey="True"/>

                                        <ToggleButton Grid.Column="1" x:Name="ToggleButton"
                                                      Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Width="28" Height="28"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Path Data="M 0 0 L 8 0 L 4 6 Z"
                                                  Fill="#6B7280" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6" Margin="0,6,0,0">
                                        <ScrollViewer MaxHeight="220">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ComboBox.Template>

                    <!-- item style for nicer hover and selection -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- Tombol Muat Ulang -->
                <Button Grid.Column="4" Height="42" Padding="16,0"
                        Click="TombolMuatUlang_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F3F4F6" BorderBrush="#E5E7EB"
                                    BorderThickness="1.5" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="16" Foreground="#374151"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Muat Ulang" FontSize="13"
                                               Foreground="#374151" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E5E7EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tombol Tambah -->
                <Button Grid.Column="6" Height="42" Padding="18,0"
                        Click="TombolTambah_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#2563EB" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="16" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tambah Buku" FontSize="13"
                                               Foreground="White" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" x:Name="TeksInfo" Text="Memuat..."
                   FontSize="13" Foreground="#6B7280" Margin="4,0,0,10"/>

        <!-- Tabel buku -->
        <Border Grid.Row="2" Background="White" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header tabel -->
                <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="14,14,0,0"
                        Padding="16,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sampul"       FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="1" Text="Judul / ISBN" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="16,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Penulis"      FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="3" Text="Kategori"     FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="4" Text="Penerbit"     FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="5" Text="Stok"         FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="6" Text="Ketersediaan" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="7" Text="Aksi"         FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="TabelBuku"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="None" HeadersVisibility="None"
                              Background="White" BorderThickness="0"
                              RowHeight="68" SelectionMode="Single"
                              AlternatingRowBackground="#FAFAFA"
                              SelectionChanged="TabelBuku_SelectionChanged"
                              MouseDoubleClick="TabelBuku_DoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Sampul buku -->
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,6" CornerRadius="6" ClipToBounds="True"
                                                Background="#F3F4F6">
                                            <Image Source="{Binding GambarSampul}"
                                                   Width="46" Height="58" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Judul + ISBN -->
                            <DataGridTemplateColumn Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Judul}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#111827"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Isbn}"
                                                       FontSize="11" Foreground="#9CA3AF"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding Penulis}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Badge Kategori -->
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Background="#EFF6FF"
                                                Padding="10,4" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Kategori}"
                                                       FontSize="11" Foreground="#2563EB"
                                                       FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding Penerbit}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Stok -->
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding JumlahStok}"
                                                       FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#111827"/>
                                            <TextBlock Text="buku" FontSize="10"
                                                       Foreground="#9CA3AF"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Badge ketersediaan + mini bar -->
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border CornerRadius="20" Padding="10,4"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tersedia}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TampilKetersediaan}"
                                                           FontSize="11" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tersedia}" Value="False">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Grid Margin="0,4,0,0" Width="110" HorizontalAlignment="Left">
                                                <Border Height="4" Background="#E5E7EB" CornerRadius="2"/>
                                                <Border Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                                        Width="{Binding StokTersedia}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tersedia}" Value="False">
                                                                    <Setter Property="Background" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Aksi: Edit & Hapus -->
                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="8,0">
                                            <Button Tag="{Binding IdBuku}"
                                                    Click="TombolEdit_Click" Cursor="Hand"
                                                    Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="#EFF6FF" CornerRadius="8" Padding="12,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="✏" FontSize="12"
                                                                           Foreground="#2563EB" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Edit" FontSize="12"
                                                                           Foreground="#2563EB" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#DBEAFE"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Tag="{Binding IdBuku}"
                                                    Click="TombolHapus_Click" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="#FEF2F2" CornerRadius="8" Padding="12,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🗑" FontSize="12"
                                                                           Foreground="#DC2626" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Hapus" FontSize="12"
                                                                           Foreground="#DC2626" FontWeight="Medium"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <Border x:Name="PanelKosong" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="48,40">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📚" FontSize="48"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Tidak ada buku yang ditemukan"
                                       FontSize="15" FontWeight="Medium"
                                       Foreground="#374151"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="Coba ubah kata kunci pencarian atau filter kategori"
                                       FontSize="12" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
