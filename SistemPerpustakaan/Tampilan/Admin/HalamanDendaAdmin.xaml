<Page x:Class="SistemPerpustakaan.Tampilan.Admin.HalamanDendaAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid x:Name="RootGrid" Margin="24">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideRoot"/></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kartu ringkasan -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12"
                    Padding="20,16" Margin="0,0,14,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="💸  Denda Belum Lunas" FontSize="13" Foreground="#6B7280" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TeksBelumLunas" Text="Rp 0"
                               FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12"
                    Padding="20,16" Margin="0,0,14,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✅  Denda Sudah Lunas" FontSize="13" Foreground="#6B7280" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TeksSudahLunas" Text="Rp 0"
                               FontSize="28" FontWeight="Bold" Foreground="#16A34A"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📋  Total Tagihan" FontSize="13" Foreground="#6B7280" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TeksTotalTagihan" Text="0 tagihan"
                               FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter -->
        <Border Grid.Row="1" Background="White" CornerRadius="12"
                Padding="16,12" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1.5"
                        CornerRadius="8" Background="White">
                    <Grid>
                        <TextBlock Text="🔍" FontSize="14" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9CA3AF"/>
                        <TextBlock Text="Cari nama peminjam..."
                                   FontSize="13" Foreground="#CBD5E1"
                                   Margin="36,0,12,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=KotakCari}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="KotakCari" Padding="36,10,12,10"
                                 FontSize="13" BorderThickness="0" Background="Transparent"
                                 Foreground="#111827"
                                 TextChanged="KotakCari_Changed"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="2" x:Name="FilterStatus"
                          Height="42" FontSize="13" Padding="12,0"
                          BorderBrush="#E5E7EB" BorderThickness="0"
                          SelectionChanged="FilterStatus_Changed"
                          Background="Transparent">
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border"
                                        Background="White"
                                        CornerRadius="10"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Padding="10,6"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          VerticalAlignment="Center"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          Margin="4,0,0,0"
                                                          RecognizesAccessKey="True"/>

                                        <ToggleButton Grid.Column="1" x:Name="ToggleButton"
                                                      Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Width="28" Height="28"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Path Data="M 0 0 L 8 0 L 4 6 Z"
                                                  Fill="#6B7280" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6" Margin="0,6,0,0">
                                        <ScrollViewer MaxHeight="220">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ComboBox.Template>

                    <!-- item style for nicer hover and selection -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>

                    <ComboBoxItem Content="Semua" IsSelected="True"/>
                    <ComboBoxItem Content="belum_lunas"/>
                    <ComboBoxItem Content="lunas"/>
                </ComboBox>

                <Button Grid.Column="4" Height="42" Padding="16,0"
                        Click="MuatUlang_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#F3F4F6" BorderBrush="#E5E7EB"
                                    BorderThickness="1.5" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="16" Foreground="#374151"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Muat Ulang" FontSize="13"
                                               Foreground="#374151" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Tabel denda -->
        <Border Grid.Row="2" Background="White" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.07" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="14,14,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nama Peminjam" FontSize="12" FontWeight="Bold" Foreground="#6B7280" Margin="16,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Tgl Kembali"   FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="2" Text="Total Denda"   FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="3" Text="Status"        FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="4" Text="Tgl Bayar"     FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="5" Text="Aksi"          FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                <DataGrid x:Name="TabelDenda"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="None" HeadersVisibility="None"
                          Background="White" BorderThickness="0"
                          RowHeight="58" SelectionMode="Single"
                          AlternatingRowBackground="#FAFAFA"
                          SelectionChanged="TabelDenda_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF9F0"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <DataGridTextColumn Binding="{Binding NamaPeminjam}" Width="*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TanggalKembali, StringFormat=dd/MM/yyyy}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total denda -->
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TampilTotal}"
                                               FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Badge Status -->
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="20" Padding="10,5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TampilStatus}"
                                                   FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding TanggalBayar, StringFormat=dd/MM/yyyy}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tombol aksi -->
                        <DataGridTemplateColumn Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="8,0">
                                        <!-- Tombol Detail -->
                                        <Button Tag="{Binding IdDenda}"
                                                Click="TombolLihatDetail_Click"
                                                Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#EFF6FF" CornerRadius="8"
                                                            Padding="10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🔍" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Detail" FontSize="11"
                                                                       Foreground="#2563EB" FontWeight="Medium"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Tombol Lunas -->
                                        <Button Tag="{Binding IdDenda}"
                                                Click="TombolLunas_Click"
                                                Cursor="Hand"
                                                IsEnabled="{Binding SudahLunas,
                                                    Converter={StaticResource BoolInverterConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Padding="10,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✅" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBlock FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Tandai Lunas"/>
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                                                <Setter Property="Text" Value="Sudah Lunas"/>
                                                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <Border x:Name="PanelKosong" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="48,40">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tidak ada data denda"
                                   FontSize="15" FontWeight="Medium" Foreground="#374151"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Semua denda telah dilunasi atau belum ada pelanggaran"
                                   FontSize="12" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
