<Page x:Class="SistemPerpustakaan.Tampilan.Pengguna.HalamanDendaPengguna"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScroll"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <ScrollViewer x:Name="RootScroll">
        <ScrollViewer.RenderTransform><TranslateTransform x:Name="SlideRoot"/></ScrollViewer.RenderTransform>
        <StackPanel Margin="28,24,28,28">

            <!-- ══ KARTU RINGKASAN ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="14"
                        Padding="22,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FEF2F2"
                                    Margin="0,0,10,0">
                                <TextBlock Text="💸" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Belum Lunas" FontSize="13"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TeksBelumLunas" Text="Rp 0"
                                   FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="14"
                        Padding="22,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#F0FDF4"
                                    Margin="0,0,10,0">
                                <TextBlock Text="✅" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sudah Lunas" FontSize="13"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TeksSudahLunas" Text="Rp 0"
                                   FontSize="28" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#EFF6FF"
                                    Margin="0,0,10,0">
                                <TextBlock Text="📋" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Tagihan" FontSize="13"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TeksJumlahTagihan" Text="0 tagihan"
                                   FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ PANEL BLOKIR ═══════════════════════════════════════ -->
            <Border x:Name="PanelBlokir" Visibility="Collapsed"
                    Background="#FEF2F2" BorderBrush="#FECACA"
                    BorderThickness="1" CornerRadius="12"
                    Padding="20,14" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="#FEE2E2" Margin="0,0,14,0">
                        <TextBlock Text="🔒" FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Akun Anda Diblokir"
                                   FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="Lunasi seluruh denda agar akun kembali aktif dan Anda dapat meminjam buku kembali."
                                   FontSize="12" Foreground="#B91C1C"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ RIWAYAT DENDA ══════════════════════════════════════ -->
            <TextBlock Text="Riwayat Denda" FontSize="16" FontWeight="Bold"
                       Foreground="#111827" Margin="0,0,0,14"/>

            <!-- Denda sebagai kartu -->
            <ItemsControl x:Name="DaftarDenda">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="14"
                                Margin="0,0,0,14" Padding="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                  Opacity="0.07" Color="#000"/>
                            </Border.Effect>
                            <StackPanel>

                                <!-- Header denda -->
                                <Border Padding="20,16" CornerRadius="14,14,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TampilTotal}"
                                                       FontSize="22" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#6B7280"
                                                       Margin="0,4,0,0">
                                                <Run Text="Tgl kembali: "/>
                                                <Run Text="{Binding TanggalKembali, StringFormat=dd MMMM yyyy}"/>
                                            </TextBlock>
                                            <!-- Tanggal bayar jika lunas -->
                                            <TextBlock FontSize="12" Foreground="#16A34A"
                                                       Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="✓ Dilunasi: "/>
                                                <Run Text="{Binding TanggalBayar, StringFormat=dd MMMM yyyy}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Badge status -->
                                        <Border Grid.Column="1" CornerRadius="20"
                                                Padding="14,6" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TampilStatus}"
                                                       FontSize="12" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SudahLunas}" Value="True">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Detail per buku -->
                                <StackPanel Margin="20,12,20,16">
                                    <TextBlock Text="Rincian denda per buku:"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding DetailBuku}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9FAFB" CornerRadius="8"
                                                        BorderBrush="#E5E7EB" BorderThickness="1"
                                                        Padding="14,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="📕"
                                                                   FontSize="16" Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding JudulBuku}"
                                                                       FontSize="13" FontWeight="Medium"
                                                                       Foreground="#111827"/>
                                                            <TextBlock Text="{Binding TampilRincian}"
                                                                       FontSize="11" Foreground="#DC2626"
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TampilSubtotal}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="#DC2626"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Panel kosong -->
            <Border x:Name="PanelKosong" Visibility="Collapsed"
                    Background="White" CornerRadius="14" Padding="48">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="48"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Tidak ada denda!"
                               FontSize="17" FontWeight="Bold"
                               Foreground="#111827" TextAlignment="Center"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="Anda disiplin dalam mengembalikan buku. Terima kasih!"
                               FontSize="13" Foreground="#9CA3AF"
                               TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
