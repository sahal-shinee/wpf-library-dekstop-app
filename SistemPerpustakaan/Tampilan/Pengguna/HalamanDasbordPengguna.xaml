<Page x:Class="SistemPerpustakaan.Tampilan.Pengguna.HalamanDasbordPengguna"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootScroll"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.RenderTransform><TranslateTransform x:Name="SlideRoot"/></ScrollViewer.RenderTransform>
        <StackPanel Margin="28,24,28,28">

            <!-- ══ BANNER SAPAAN ════════════════════════════════════════ -->
            <Border CornerRadius="16" Margin="0,0,0,24" Height="130">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1D4ED8" Offset="0"/>
                        <GradientStop Color="#0891B2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2" Color="#1D4ED8"/>
                </Border.Effect>
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TeksSapaan"
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TeksNama"
                                   FontSize="13" Foreground="#BFDBFE" Margin="0,5,0,0"/>
                        <Border x:Name="PanelStatusAkun" Visibility="Collapsed"
                                Background="#7F1D1D" CornerRadius="6"
                                Padding="10,4" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="TeksStatusAkun"
                                       FontSize="12" Foreground="#FCA5A5" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                    <!-- Ikon dekoratif -->
                    <Border Grid.Column="1" Width="80" Height="80"
                            CornerRadius="40" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.15"/>
                        </Border.Background>
                        <TextBlock Text="📚" FontSize="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ KARTU STATISTIK ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Dipinjam -->
                <Border Grid.Column="0" Background="White" CornerRadius="14"
                        Padding="22,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sedang Dipinjam" FontSize="13"
                                       Foreground="#6B7280" Margin="0,0,0,10"/>
                            <TextBlock x:Name="JumlahDipinjam" Text="0"
                                       FontSize="38" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="buku aktif" FontSize="12"
                                       Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48"
                                CornerRadius="12" Background="#EFF6FF"
                                VerticalAlignment="Top">
                            <TextBlock Text="📤" FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Hampir Jatuh Tempo -->
                <Border Grid.Column="1" Background="White" CornerRadius="14"
                        Padding="22,18" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hampir Jatuh Tempo" FontSize="13"
                                       Foreground="#6B7280" Margin="0,0,0,10"/>
                            <TextBlock x:Name="JumlahHampirTempo" Text="0"
                                       FontSize="38" FontWeight="Bold" Foreground="#D97706"/>
                            <TextBlock Text="≤ 2 hari lagi" FontSize="12"
                                       Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48"
                                CornerRadius="12" Background="#FFF7ED"
                                VerticalAlignment="Top">
                            <TextBlock Text="⏰" FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Denda -->
                <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Denda Aktif" FontSize="13"
                                       Foreground="#6B7280" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalDenda" Text="Rp 0"
                                       FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                            <TextBlock Text="belum lunas" FontSize="12"
                                       Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48"
                                CornerRadius="12" Background="#FEF2F2"
                                VerticalAlignment="Top">
                            <TextBlock Text="💰" FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ PERINGATAN DENDA ═════════════════════════════════════ -->
            <Border x:Name="PanelPeringatanDenda" Visibility="Collapsed"
                    Background="#FEF2F2" BorderBrush="#FECACA"
                    BorderThickness="1" CornerRadius="12"
                    Padding="20,14" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="#FEE2E2" Margin="0,0,14,0">
                        <TextBlock Text="⚠" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#DC2626"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Anda memiliki denda yang belum dilunasi!"
                                   FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock x:Name="TeksDetailDenda"
                                   FontSize="12" Foreground="#B91C1C" Margin="0,3,0,0"/>
                        <TextBlock Text="Peminjaman baru tidak dapat dilakukan hingga denda dilunasi."
                                   FontSize="11" Foreground="#EF4444" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ BUKU AKTIF DIPINJAM ══════════════════════════════════ -->
            <Border Background="White" CornerRadius="14" Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.07" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Buku Aktif Dipinjam" FontSize="16"
                                       FontWeight="Bold" Foreground="#111827"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Cursor="Hand"
                                Click="TombolLihatSemua_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="0">
                                        <TextBlock Text="Lihat Semua Riwayat →"
                                                   FontSize="13" Foreground="#2563EB"
                                                   FontWeight="Medium"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Daftar buku aktif sebagai kartu -->
                    <ItemsControl x:Name="DaftarBukuAktif">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" CornerRadius="10"
                                        BorderBrush="#E5E7EB" BorderThickness="1"
                                        Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ikon buku -->
                                        <Border Grid.Column="0" Width="42" Height="52"
                                                CornerRadius="6" Background="#DBEAFE"
                                                Margin="0,0,14,0">
                                            <TextBlock Text="📗" FontSize="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Info buku -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding JudulBuku}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#111827"/>
                                            <TextBlock Text="{Binding PenulisBuku}"
                                                       FontSize="12" Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <Border CornerRadius="4" Background="#EFF6FF"
                                                    Padding="6,2" Margin="0,5,0,0"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding KategoriBuku}"
                                                           FontSize="11" Foreground="#1D4ED8"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Status -->
                                        <Border Grid.Column="3" CornerRadius="8"
                                                Padding="12,6" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SudahKembali}" Value="True">
                                                            <Setter Property="Background" Value="#F0FDF4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TampilStatusBuku}"
                                                       FontSize="12" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SudahKembali}" Value="True">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pesan kosong -->
                    <Border x:Name="PanelKosong" Visibility="Collapsed"
                            Background="#F9FAFB" CornerRadius="10"
                            Padding="32" Margin="0,4,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📭" FontSize="36"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Tidak ada buku yang sedang dipinjam."
                                       FontSize="13" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Kunjungi menu Cari &amp; Pinjam Buku untuk mulai meminjam."
                                       FontSize="12" Foreground="#D1D5DB"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
