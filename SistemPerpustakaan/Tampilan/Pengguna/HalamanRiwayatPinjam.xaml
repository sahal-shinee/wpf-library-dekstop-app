<Page x:Class="SistemPerpustakaan.Tampilan.Pengguna.HalamanRiwayatPinjam"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid x:Name="RootGrid">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideRoot"/></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1.5"
                        CornerRadius="8" Background="White">
                    <ComboBox x:Name="FilterStatus" FontSize="13"
                              BorderThickness="0" Background="Transparent"
                              Padding="12,10"
                              SelectionChanged="FilterStatus_Changed">
                        <ComboBoxItem Content="Semua Peminjaman" IsSelected="True"/>
                        <ComboBoxItem Content="Aktif"/>
                        <ComboBoxItem Content="Terlambat"/>
                        <ComboBoxItem Content="Selesai"/>
                    </ComboBox>
                </Border>

                <Button Grid.Column="2" Height="42" Padding="16,0"
                        Click="MuatUlang_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#F3F4F6" BorderBrush="#E5E7EB"
                                    BorderThickness="1.5" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="16" Foreground="#374151"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Muat Ulang" FontSize="13"
                                               Foreground="#374151" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Grid.Column="3" x:Name="TeksInfo" Text=""
                           FontSize="13" Foreground="#6B7280"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- Daftar peminjaman sebagai kartu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,28">

                <!-- Loading indicator -->
                <Border x:Name="PanelMuatRiwayat" Visibility="Visible"
                        Background="White" CornerRadius="12" Padding="40">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="32"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Memuat riwayat peminjaman..."
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kosong -->
                <Border x:Name="PanelKosongRiwayat" Visibility="Collapsed"
                        Background="White" CornerRadius="12" Padding="48">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.06" Color="#000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="42"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Belum ada riwayat peminjaman."
                                   FontSize="15" FontWeight="Medium"
                                   Foreground="#374151"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Kunjungi menu Cari &amp; Pinjam Buku untuk mulai meminjam."
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Daftar kartu peminjaman -->
                <ItemsControl x:Name="DaftarPeminjaman">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="14"
                                    Margin="0,0,0,16" Padding="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                      Opacity="0.07" Color="#000"/>
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Header kartu -->
                                    <Border Padding="20,16" CornerRadius="14,14,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="terlambat">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="sebagian_kembali">
                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="selesai">
                                                        <Setter Property="Background" Value="#F9FAFB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="aktif">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Info peminjaman -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Peminjaman #"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="#374151"/>
                                                    <TextBlock Text="{Binding IdPeminjaman}"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="#374151"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📅 " FontSize="12"
                                                               Foreground="#6B7280"/>
                                                    <TextBlock Text="Pinjam: "
                                                               FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding TanggalPinjam, StringFormat=dd MMMM yyyy}"
                                                               FontSize="12" Foreground="#6B7280"
                                                               Margin="0,0,16,0"/>
                                                    <TextBlock Text="📅 " FontSize="12"
                                                               Foreground="#6B7280"/>
                                                    <TextBlock Text="Batas: "
                                                               FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding BatasKembali, StringFormat=dd MMMM yyyy}"
                                                               FontSize="12" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#374151"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Terlambat}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Info terlambat -->
                                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                                           FontWeight="Medium" Foreground="#DC2626">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Terlambat}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="⚠  Terlambat "/>
                                                    <Run Text="{Binding HariTerlambat, Mode=OneWay}"/>
                                                    <Run Text=" hari — akan dikenakan denda"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Badge status -->
                                            <Border Grid.Column="1" CornerRadius="20"
                                                    Padding="14,6" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="terlambat">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="sebagian_kembali">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="selesai">
                                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TampilStatus}"
                                                           FontSize="12" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="terlambat">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="sebagian_kembali">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="selesai">
                                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Daftar buku dalam peminjaman ini -->
                                    <StackPanel Margin="20,12,20,0">
                                        <TextBlock Text="Buku yang dipinjam:"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#6B7280" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding DetailBuku}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F9FAFB" CornerRadius="8"
                                                            BorderBrush="#E5E7EB" BorderThickness="1"
                                                            Padding="14,10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="📗"
                                                                       FontSize="16" Margin="0,0,10,0"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding JudulBuku}"
                                                                           FontSize="13" FontWeight="Medium"
                                                                           Foreground="#111827"/>
                                                                <TextBlock Text="{Binding PenulisBuku}"
                                                                           FontSize="11" Foreground="#9CA3AF"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" CornerRadius="6"
                                                                    Padding="8,4" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SudahKembali}" Value="True">
                                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding TampilStatusBuku}"
                                                                           FontSize="11" FontWeight="Medium">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SudahKembali}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Panel kembalikan (hanya jika masih ada yang dipinjam) -->
                                    <Border x:Name="PanelKembalikanItem"
                                            Padding="20,14,20,16" Margin="0,8,0,0"
                                            BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="aktif">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="sebagian_kembali">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="terlambat">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Tag="{Binding IdPeminjaman}"
                                                Click="TombolKembalikanDariKartu_Click"
                                                Cursor="Hand" HorizontalAlignment="Left">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#1D4ED8" CornerRadius="8"
                                                            Padding="16,9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📥 " FontSize="13"
                                                                       Foreground="White"/>
                                                            <TextBlock Text="Kembalikan Buku"
                                                                       FontSize="13" Foreground="White"
                                                                       FontWeight="Medium"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Dialog Kembalikan (overlay) -->
        <Border x:Name="OverlayKembalikan" Visibility="Collapsed"
                Grid.RowSpan="2" Background="#80000000">
            <Border Background="White" CornerRadius="16"
                    Padding="28" MaxWidth="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.3" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Kembalikan Buku" FontSize="18" FontWeight="Bold"
                               Foreground="#111827" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TeksInfoKembalikan" FontSize="13"
                               Foreground="#6B7280" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Daftar buku dengan checkbox -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,16">
                        <ItemsControl x:Name="DaftarBukuKembalikan" Padding="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" BorderBrush="#F3F4F6"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Dipilih}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding JudulBuku}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="#111827"/>
                                                <TextBlock Text="{Binding PenulisBuku}"
                                                           FontSize="11" Foreground="#9CA3AF"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2"
                                                      SelectedValue="{Binding Kondisi, Mode=TwoWay}"
                                                      SelectedValuePath="Content"
                                                      FontSize="12" Height="34"
                                                      BorderBrush="#E5E7EB">
                                                <ComboBoxItem Content="baik" IsSelected="True"/>
                                                <ComboBoxItem Content="rusak_ringan"/>
                                                <ComboBoxItem Content="rusak_berat"/>
                                                <ComboBoxItem Content="hilang"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Tombol aksi -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Batal" Click="TombolBatalKembalikan_Click"
                                Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F3F4F6" BorderBrush="#E5E7EB"
                                            BorderThickness="1" CornerRadius="8" Padding="20,10">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Click="TombolKonfirmasiKembalikan_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1D4ED8" CornerRadius="8" Padding="20,10">
                                        <TextBlock Text="✅  Proses Pengembalian"
                                                   Foreground="White" FontWeight="Medium"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
