<Page x:Class="SistemPerpustakaan.Tampilan.Pengguna.HalamanCariPinjamBuku"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="SlideRoot"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid x:Name="RootGrid">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideRoot"/></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar pencarian -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Kotak cari -->
                <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1.5"
                        CornerRadius="10" Background="White">
                    <Grid>
                        <TextBlock Text="🔍" FontSize="16" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9CA3AF"/>
                        <TextBox x:Name="KotakCari"
                                 Padding="44,12,14,12" FontSize="14"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#111827"
                                 TextChanged="KotakCari_Changed"/>
                    </Grid>
                </Border>

                <!-- Filter kategori -->
                <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="1.5"
                        CornerRadius="10" Background="White">
                    <ComboBox x:Name="FilterKategori"
                              FontSize="13" BorderThickness="0" Background="Transparent"
                              Padding="12,10"
                              SelectionChanged="FilterKategori_Changed"/>
                </Border>

                <!-- Toggle tersedia -->
                <ToggleButton Grid.Column="4" x:Name="FilterTersedia"
                              Height="44" Padding="16,0"
                              FontSize="13" Cursor="Hand"
                              Checked="Filter_Changed" Unchecked="Filter_Changed">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="White"
                                    BorderBrush="#E5E7EB" BorderThickness="1.5"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Ikon" Text="○" FontSize="13"
                                               Foreground="#9CA3AF" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Tersedia saja" FontSize="13"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#93C5FD"/>
                                    <Setter TargetName="Ikon" Property="Text" Value="●"/>
                                    <Setter TargetName="Ikon" Property="Foreground" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Panel keranjang -->
        <Border Grid.Row="1" x:Name="PanelKeranjang" Visibility="Collapsed"
                Background="#1D4ED8" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14"
                            Background="#3B82F6" Margin="0,0,10,0">
                        <TextBlock Text="🛒" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TeksKeranjang" FontSize="13"
                               Foreground="White" VerticalAlignment="Center"
                               FontWeight="Medium"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Batal" Click="TombolBatalPilihan_Click"
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#3B82F6" CornerRadius="8" Padding="14,8">
                                    <TextBlock Text="Batal" FontSize="12"
                                               Foreground="White"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="TombolPinjam"
                            Click="TombolPinjam_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="White" CornerRadius="8" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📤 " FontSize="13" Foreground="#1D4ED8"/>
                                        <TextBlock Text="Pinjam Sekarang" FontSize="13"
                                                   Foreground="#1D4ED8" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Info hasil -->
        <TextBlock Grid.Row="2" x:Name="TeksInfo"
                   Text="Memuat koleksi buku..."
                   FontSize="13" Foreground="#6B7280"
                   Margin="24,14,24,4"/>

        <!-- Grid buku -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Loading -->
                <Border x:Name="PanelMuat" Visibility="Visible" Height="200">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Memuat koleksi buku..."
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kosong -->
                <Border x:Name="PanelKosong" Visibility="Collapsed" Height="200">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tidak ada buku yang sesuai."
                                   FontSize="14" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- WrapPanel kartu buku -->
                <WrapPanel x:Name="GridBuku" Margin="18,8,18,24"
                           Orientation="Horizontal"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
